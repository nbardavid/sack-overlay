{
  "schemaVersion": 1,
  "id": "sackoverlay",
  "version": "${version}",
  "name": "Sack Overlay",
  "description": "A clean overview of your Hypixel SkyBlock sacks. Client-side only.",
  "authors": ["lourio"],
  "contact": {
    "homepage": "https://github.com/nbardavid/sack-overlay",
    "sources": "https://github.com/nbardavid/sack-overlay",
    "issues": "https://github.com/nbardavid/sack-overlay/issues"
  },
  "license": "MIT",
  "icon": "assets/sackoverlay/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      { "value": "io.github.sackoverlay.SackOverlay", "adapter": "kotlin" }
    ],
    "modmenu": [
      "io.github.sackoverlay.SackModMenu"
    ]
  },
  "mixins": ["sackoverlay.mixins.json"],
  "accessWidener": "sackoverlay.accesswidener",
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "~${minecraft}",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=${fabric_kotlin}",
    "skyblock-api": ">=${sbapi}"
  },
  "suggests": {
    "modmenu": "*"
  }
}
